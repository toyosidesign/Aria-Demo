{
  "expo": {
    "name": "aria-demo",
    "slug": "aria-demo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ariademo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "googlegmail",
          "sms",
          "tel",
          "mailto",
          "whatsapp"
        ],
        "NSFaceIDUsageDescription": "Aria uses Face ID to unlock your tasks so only you can see them."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#333D56",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#333D56",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Aria uses your photos so you can set a profile picture.",
          "cameraPermission": "Aria uses your camera so you can take a profile picture."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Aria uses your contacts so it can address a text or email without you retyping someone's details."
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
